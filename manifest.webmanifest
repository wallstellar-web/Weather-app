    { "name": "Hiker", "short_name": "Hiker", "description": "Trail conditions and rain timing", "url": "./#hike", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Off-road", "short_name": "Off-road", "description": "Mud score, river crossings and ghat risk", "url": "./#off", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
